{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "forkProcessing": "enabled",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "This project tracks the Scala 3 LTS line, currently 3.9.x. `scala` is the name the built-in sbt manager uses; the glob covers everything else under the organisation.",
      "matchPackageNames": [
        "scala",
        "org.scala-lang:**"
      ],
      "allowedVersions": "/^3\\.9\\./"
    },
    {
      "description": "Group the test framework so scalatest and scalactic move together.",
      "groupName": "scalatest",
      "matchPackageNames": [
        "org.scalatest:**",
        "org.scalactic:**"
      ]
    },
    {
      "description": "Group the two build definitions so sbt and Mill never drift apart.",
      "groupName": "build tooling",
      "matchFileNames": [
        "project/build.properties",
        ".mill-version",
        "mill"
      ]
    },
    {
      "description": "sbt 2.x is a breaking change to the build definition. Stay on the 1.x line until that migration is done deliberately. `sbt/sbt` is the name the built-in sbt manager uses for project/build.properties.",
      "matchPackageNames": [
        "sbt/sbt",
        "org.scala-sbt:**"
      ],
      "allowedVersions": "/^1\\./"
    },
    {
      "description": "Same for Mill: a future 2.x would change the build API, so take it on purpose rather than by pull request.",
      "matchPackageNames": [
        "com-lihaoyi/mill"
      ],
      "allowedVersions": "/^1\\./"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Mill version pinned in .mill-version",
      "managerFilePatterns": [
        "/^\\.mill-version$/"
      ],
      "matchStrings": [
        "(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "com-lihaoyi/mill",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Scala dependencies in the Mill build: `mvn\"org::artifact:version\"` resolves to the _3 artifact",
      "managerFilePatterns": [
        "/^build\\.mill$/"
      ],
      "matchStrings": [
        "mvn\"(?<organization>[^:\"]+)::(?<artifact>[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "{{{organization}}}:{{{artifact}}}_3",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Java dependencies in the Mill build: `mvn\"org:artifact:version\"`",
      "managerFilePatterns": [
        "/^build\\.mill$/"
      ],
      "matchStrings": [
        "mvn\"(?<organization>[^:\"]+):(?<artifact>[^:\"][^:\"]*):(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "{{{organization}}}:{{{artifact}}}",
      "datasourceTemplate": "maven"
    }
  ]
}
